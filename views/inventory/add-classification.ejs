<% if (title) { %>
<h1><%= title %></h1>
<% } else {
  res.redirect('/')
} %>
<% if (errors) { %>
  <ul class="notice">
 <% errors.array().forEach(error => { %>
   <li><%= error.msg %></li>
<%  }) %>
 </ul>
<% } %>
<div>
    <form class="addClasification" action="/inv/add-classification" method="post">
        <legend>Field Is Required</legend>
        <div class="formClasification">
            <label for="classificationName">Classification Name: </label>
            <span>Name must be alphabetic character only</span> 
            <input type="text" id="classificationName" name="classification_name" required value="<%= locals.classification_name %>" pattern="[A-Za-z]+">
        </div>
        <button type="submit"> Add Clasification </button>
    </form>
</div>