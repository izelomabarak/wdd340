<% if (title) { %>
<h1><%= title %></h1>
<% } else {
  res.redirect('/')
} %>
<% if (errors) { %>
  <ul class="notice">
 <% errors.array().forEach(error => { %>
   <li><%= error.msg %></li>
<%  }) %>
 </ul>
<% } %>
<div class="formsInv">
  <form id="updateForm" class="addInformation" action="/inv/update" method="post">
    <legend>All Fields Are Required</legend>    
    <div class="formInformation">
      <label for="classificationList">Classification:</label>
      <%- grid %>
      <label for="makeName">Make:</label>
      <input type="text" minlength="3" id="makeName" name="inv_make" required value="<%= locals.inv_make %>" placeholder="Min of  3 characters">
      <label for="modelName">Model:</label>
      <input type="text" minlength="3" id="modelName" name="inv_model" required value="<%= locals.inv_model %>" placeholder="Min of  3 characters">
      <label for="descriptionName">Description:</label>
      <input type="text" id="descriptionName" name="inv_description" required value="<%= locals.inv_description %>">
      <label for="imagePath">Image Path:</label>
      <input type="text" id="imagePath" name="inv_image" required value="/images/vehicles/no-image.png">
      <label for="thumbnailPath">Thumbnail Path:</label>
      <input type="text" id="thumbnailPath" name="inv_thumbnail" required value="/images/vehicles/no-image.png">
      <label for="price">Price:</label>
      <input type="number" id="price" name="inv_price" required value="<%= locals.inv_price %>" placeholder="Decimal or Integer">
      <label for="year">Year:</label>
      <input type="text" id="year" name="inv_year" inputmode="numeric" pattern="\d{4}" maxlength="4" required value="<%= locals.inv_year %>" placeholder="4-digit year">
      <label for="miles">Miles:</label>
      <input type="number" id="miles" name="inv_miles" required value="<%= locals.inv_miles %>" placeholder="Digits Only">
      <label for="color">Color:</label>
      <input type="text" id="color" name="inv_color" required value="<%= locals.inv_color %>">
      <button type="submit" disabled>Update Vehicle</button>
      <input type="hidden" name="inv_id"
      <% if(locals.inv_id) { %> value="<%= locals.inv_id %>"
      <% } %>>
    </div>
  </form>
  <script src="../../js/inv-update.js"></script>
</div>